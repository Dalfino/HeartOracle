# HeartOracle Platform — Next.js dashboard (multi-stage, standalone output)
# Build:  docker build -f docker/Dockerfile.platform -t heartoracle-platform .
# Run:    docker run -p 3000:3000 heartoracle-platform

# ---------- deps ----------
FROM oven/bun:1 AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# ---------- build ----------
FROM oven/bun:1 AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# NEXT_TELEMETRY_DISABLED=1
ENV NEXT_TELEMETRY_DISABLED=1
# DATABASE_URL placeholder keeps prisma generate happy when schema references env
ENV DATABASE_URL="file:./db/custom.db"
RUN bunx prisma generate || true
RUN bun run build

# ---------- runtime ----------
FROM oven/bun:1-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# non-root user (CIS hardening baseline)
RUN addgroup --system --gid 1001 oracle && adduser --system --uid 1001 oracle

COPY --from=builder --chown=oracle:oracle /app/.next/standalone ./
COPY --from=builder --chown=oracle:oracle /app/.next/static ./.next/static
COPY --from=builder --chown=oracle:oracle /app/public ./public

USER oracle
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:3000/api/oracle/eval').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["bun", "server.js"]
